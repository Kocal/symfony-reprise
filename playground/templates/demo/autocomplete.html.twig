{% extends 'page.html.twig' %}

{% block content %}
    <twig:Panel>
        <label class="block font-medium">
            Pick your bundler
            <select data-controller="symfony--ux-autocomplete--autocomplete" data-placeholder="Search…" class="mt-2 block min-w-[260px] rounded-lg border border-slate-200 px-2.5 py-2">
                <option value="">—</option>
                <option>Vite</option>
                <option>Rspack</option>
                <option>Rsbuild</option>
                <option>esbuild</option>
                <option>Rollup</option>
                <option>Webpack</option>
                <option>Parcel</option>
                <option>Turbopack</option>
            </select>
        </label>
    </twig:Panel>
{% endblock %}
