{% extends 'base.html.twig' %}

{% block body %}
    <div class="mx-auto max-w-5xl px-6 py-8">
        <h1 class="mb-1 text-3xl font-bold">Reprise Playground</h1>
        <p class="mt-0 text-slate-500">A Symfony app exercising Reprise (Vite + Rsbuild) and the Symfony UX ecosystem — one interactive card per feature.</p>

        <h2 class="mt-8 mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Reprise / bundler features</h2>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(230px,1fr))] gap-4">
            {% for item in features %}
                <twig:DemoCard :item="item" />
            {% endfor %}
        </div>

        <h2 class="mt-8 mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Symfony UX</h2>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(230px,1fr))] gap-4">
            {% for item in ux %}
                <twig:DemoCard :item="item" />
            {% endfor %}
        </div>
    </div>
{% endblock %}
