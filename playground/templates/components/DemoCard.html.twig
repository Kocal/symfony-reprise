{% props item %}

<a class="block rounded-xl border border-slate-200 bg-white p-4 text-inherit no-underline transition hover:-translate-y-0.5 hover:border-emerald-500 hover:shadow-lg" href="{{ path(item.route, item.params) }}">
    <div class="text-2xl">{{ item.icon }}</div>
    <h3 class="mt-2 mb-1 text-base font-bold">{{ item.title }}</h3>
    <p class="m-0 text-sm text-slate-500">{{ item.description }}</p>
</a>
